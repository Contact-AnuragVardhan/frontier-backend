PORT=4000

# Supabase server-side access. Prefer the newer sb_secret_... key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
# Legacy/fallback name is also supported:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# OpenAI - used by /api/chat for query understanding, embeddings, and grounded responses.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Optional separate model for retrieval-query rewriting. Defaults to OPENAI_CHAT_MODEL.
OPENAI_QUERY_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=90000

# RAG retrieval. Leave KNOWLEDGE_SOURCE_KEY blank to search all ready sources.
KNOWLEDGE_SOURCE_KEY=
RETRIEVAL_MATCH_COUNT=6
RETRIEVAL_MATCH_THRESHOLD=0.35
RETRIEVAL_QUERY_COUNT=3
RAG_MAX_CONTEXT_CHARS=32000

# Recent conversation supplied by the UI is used only to resolve references/follow-ups.
CHAT_HISTORY_MAX_MESSAGES=8
CHAT_HISTORY_MAX_CHARS=6000

ALLOWED_ORIGINS=http://localhost:5173,https://relaxed-nougat-04cdf5.netlify.app,https://frontiereducationproject.com,https://www.frontiereducationproject.com
