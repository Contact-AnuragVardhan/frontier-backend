PORT=4000

# Supabase server-side access. Prefer the newer sb_secret_... key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
# Legacy/fallback name is also supported:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# OpenAI - used by /api/chat for query understanding, embeddings, and grounded responses.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Optional separate model for retrieval-query rewriting. Defaults to OPENAI_CHAT_MODEL.
OPENAI_QUERY_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=90000

# RAG retrieval. Leave KNOWLEDGE_SOURCE_KEY blank to search all ready sources.
# Existing Supabase table/RPC names may still contain "frontier" internally; they are intentionally unchanged.
KNOWLEDGE_SOURCE_KEY=
RETRIEVAL_MATCH_COUNT=6
RETRIEVAL_MATCH_THRESHOLD=0.35
RETRIEVAL_QUERY_COUNT=3
RAG_MAX_CONTEXT_CHARS=32000

# Recent conversation supplied by the UI is used only to resolve references/follow-ups.
CHAT_HISTORY_MAX_MESSAGES=8
CHAT_HISTORY_MAX_CHARS=6000

# Add the temporary review URL here when it is known.
ALLOWED_ORIGINS=http://localhost:5173,https://aichoice.org,https://www.aichoice.org

# -----------------------------------------------------------------------------
# Email notifications (Resend)
# -----------------------------------------------------------------------------
# The backend uses the Resend HTTPS API directly; no extra npm mail package is required.
# Create a Resend API key and verify the sender/domain used in EMAIL_FROM_ADDRESS.
EMAIL_NOTIFICATIONS_ENABLED=true
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_FROM_ADDRESS=AI Choice <website@aichoice.org>
EMAIL_REQUEST_TIMEOUT_MS=15000

# IMPORTANT: each form/screen has its own destination variable so these can be
# changed independently later without modifying code. Comma-separated values
# are supported if a form should notify more than one address.
CONTACT_FORM_TO_EMAIL=contact@aichoice.org
NEWSLETTER_SIGNUP_TO_EMAIL=newsletter@aichoice.org

# -----------------------------------------------------------------------------
# Email templates
# -----------------------------------------------------------------------------
# Templates use {{placeholder}} syntax. Use \n in text template environment
# values when you want a line break. If a variable is omitted, the backend uses
# the built-in default template.
#
# Contact placeholders:
#   {{name}} {{email}} {{inquiryType}} {{message}} {{submittedAt}} {{submissionId}}
CONTACT_EMAIL_SUBJECT_TEMPLATE=[AI Choice] New {{inquiryType}} contact inquiry
CONTACT_EMAIL_TEXT_TEMPLATE=A new contact request was submitted on the AI Choice website.\n\nName: {{name}}\nEmail: {{email}}\nInquiry type: {{inquiryType}}\nSubmitted: {{submittedAt}}\nSubmission ID: {{submissionId}}\n\nMessage:\n{{message}}
CONTACT_EMAIL_HTML_TEMPLATE=<h2>New AI Choice contact inquiry</h2><table cellpadding="6" cellspacing="0" border="0"><tr><td><strong>Name</strong></td><td>{{name}}</td></tr><tr><td><strong>Email</strong></td><td>{{email}}</td></tr><tr><td><strong>Inquiry type</strong></td><td>{{inquiryType}}</td></tr><tr><td><strong>Submitted</strong></td><td>{{submittedAt}}</td></tr><tr><td><strong>Submission ID</strong></td><td>{{submissionId}}</td></tr></table><h3>Message</h3><p style="white-space:pre-wrap">{{message}}</p>

# Newsletter placeholders:
#   {{email}} {{submittedAt}} {{submissionId}}
NEWSLETTER_EMAIL_SUBJECT_TEMPLATE=[AI Choice] New newsletter signup
NEWSLETTER_EMAIL_TEXT_TEMPLATE=A new visitor signed up for AI Choice Brief.\n\nEmail: {{email}}\nSubmitted: {{submittedAt}}\nSubmission ID: {{submissionId}}
NEWSLETTER_EMAIL_HTML_TEMPLATE=<h2>New AI Choice Brief signup</h2><p>A new visitor signed up for AI Choice Brief.</p><table cellpadding="6" cellspacing="0" border="0"><tr><td><strong>Email</strong></td><td>{{email}}</td></tr><tr><td><strong>Submitted</strong></td><td>{{submittedAt}}</td></tr><tr><td><strong>Submission ID</strong></td><td>{{submissionId}}</td></tr></table>
